 ha:layer_stack {
  li:groups {
   ha:0 { name = top_copper;     ha:type { copper=1; top=1; }       li:layers { 0; } }
   ha:1 { name = grp_substrate;  ha:type { substrate=1; intern=1; } li:layers { }
           ha:attributes { thickness=1.5mm } }
   ha:2 { name = bottom_copper;  ha:type { copper=1; bottom=1; }    li:layers { 1; } }
   ha:3 { name = global_outline; ha:type { boundary=1; }            li:layers { 2; }
           purpose = uroute }
   ha:4 { name = top_silk;       ha:type { silk=1; top=1; }         li:layers { 3; } }
   ha:5 { name = bottom_silk;    ha:type { silk=1; bottom=1; }      li:layers { 4; } }
  }
 }

 ha:netlists {
   li:input {
    ha:GND {
     li:conn { C1-2; C2-2; C3-2; C4-2; D1-1; PAD2-1; Q1-1; Q2-2; R15-2; R16-2; TP6-1; U1-4; }
