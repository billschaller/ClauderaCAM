 ha:layer_stack {
  li:groups {
   ha:0 { name = top_copper;     ha:type { copper=1; top=1; }       li:layers { 0; } }
   ha:1 { name = grp_substrate;  ha:type { substrate=1; intern=1; } li:layers { }
           ha:attributes { thickness=1.5mm } }
   ha:2 { name = bottom_copper;  ha:type { copper=1; bottom=1; }    li:layers { 1; } }
   ha:3 { name = global_outline; ha:type { boundary=1; }            li:layers { 2; }
           purpose = uroute }
   ha:4 { name = top_silk;       ha:type { silk=1; top=1; }         li:layers { 3; } }
   ha:5 { name = bottom_silk;    ha:type { silk=1; bottom=1; }      li:layers { 4; } }
  }
 }

 ha:netlists {
   li:input {
    ha:GND {
     li:conn { C1-2; C2-2; C3-2; C4-2; D1-1; PAD2-1; Q1-1; Q2-2; R15-2; R16-2; TP6-1; U1-4; }
    }
    ha:L0 {
     li:conn { LED1-2; LED3-2; LED5-2; R2-2; R4-2; R6-2; TP4-1; U1-5; }
    }
    ha:L1 {
     li:conn { LED2-2; LED7-2; LED9-2; R1-2; R10-2; R8-2; TP1-1; U1-6; }
    }
    ha:L2 {
     li:conn { LED11-2; LED4-2; LED8-2; R12-2; R3-2; R7-2; S2-1; S2-1B; TP3-1; U1-7; }
    }
    ha:L3 {
     li:conn { LED10-2; LED12-2; LED6-2; R11-2; R5-2; R9-2; S1-1; S1-1B; U1-2; }
    }
    ha:LED10_K {
     li:conn { LED10-1; R10-1; }
    }
    ha:LED11_K {
     li:conn { LED11-1; R11-1; }
    }
    ha:LED12_K {
     li:conn { LED12-1; R12-1; }
    }
    ha:LED1_K {
     li:conn { LED1-1; R1-1; }
    }
    ha:LED2_K {
     li:conn { LED2-1; R2-1; }
    }
    ha:LED3_K {
     li:conn { LED3-1; R3-1; }
    }
    ha:LED4_K {
     li:conn { LED4-1; R4-1; }
    }
    ha:LED5_K {
     li:conn { LED5-1; R5-1; }
    }
    ha:LED6_K {
     li:conn { LED6-1; R6-1; }
    }
    ha:LED7_K {
     li:conn { LED7-1; R7-1; }
    }
    ha:LED8_K {
     li:conn { LED8-1; R8-1; }
    }
    ha:LED9_K {
     li:conn { LED9-1; R9-1; }
    }
    ha:RESET {
     li:conn { C4-1; R13-2; TP5-1; U1-1; }
    }
    ha:S1_R {
     li:conn { R15-1; S1-2; S1-2B; }
    }
    ha:S2_R {
     li:conn { R16-1; S2-2; S2-2B; }
    }
    ha:SND {
     li:conn { R14-1; U1-3; }
    }
    ha:SND_B {
     li:conn { Q2-1; R14-2; }
    }
    ha:SND_C {
     li:conn { BZ1-2; D1-3; Q2-3; }
    }
    ha:VBAT {
     li:conn { PAD1-1; SW1-2; }
    }
    ha:VCC {
     li:conn { BZ1-1; C1-1; C2-1; C3-1; D1-2; Q1-2; R13-1; TP2-1; U1-8; }
    }
    ha:VSW {
     li:conn { Q1-3; SW1-1; }
    }
   }
 }
}
